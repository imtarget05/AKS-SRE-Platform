# Template for operational deploy credentials.
# Copy to scripts/.env (gitignored), fill values, then: source scripts/.env
# RULES:
#   - Put NOTHING real in this file. Placeholders only.
#   - All values below were revoked/rotated on 2026-11-07 if they ever
#     appeared in chat, files, or logs. Do not reuse them.
#   - scripts/.env must never be committed.

# --- ArgoCD (sync-argocd.sh / check-argocd.sh) ---
ARGOCD_SERVER="argocd.example.com"
ARGOCD_USERNAME=""
ARGOCD_PASSWORD=""
# TLS verification is ON by default; only override for self-signed dev clusters
ARGOCD_INSECURE="false"
APP_NAME="aks-sre-platform"
REVISION="main"
SYNC_TIMEOUT="600"

# --- Render (deploy-render.sh) ---
# The full deploy-hook URL is itself a credential. Get a fresh one from
# Render dashboard > Service > Settings > Deploy Hook.
RENDER_DEPLOY_HOOK="https://api.render.com/deploy/srv-XXXXXXXX?key=REPLACE_AFTER_ROTATION"

# --- Cloudflare Pages (deploy-cloudflare-pages.sh) ---
# DIRECT-UPLOAD projects only. Create a scoped token:
# dash.cloudflare.com > My Profile > API Tokens (permissions: Pages: Edit)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_PROJECT_NAME=""

# SONARQUBE / GITHUB / NEON tokens are NOT needed by these scripts.
# If a CI workflow needs them, they must come from GitHub Actions secrets
# or CI variables — never from this file, never from chat.
SONAR_TOKEN=""
GITHUB_TOKEN=""
