# Terraform (never commit state or provider binaries; lock file IS committed)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
*.tfplan
**/plan.out
**/plan.json
**/tfplan*
**/*.auto.tfvars
crash.log

# Raw local artifacts (terraform plans, scratch) — never commit; sanitized evidence goes to docs/evidence/
**/.local/
*.dump

# Sanitized plan snapshots must not live in the Terraform source area — they are
# historical evidence and belong under docs/evidence/<phase>/. Regenerate with
# `terraform plan -out=<phase>.tfplan`, then hand-sanitize into docs/evidence/.
terraform/**/plan.txt
terraform/**/plan-summary.md

# Local env files — never commit real credentials
.env
.pytest_cache/
__pycache__/
*.pyc
*.db
.env.*
!.env.example

# Node (app/sre-demo-api)
node_modules/
npm-debug.log*
*.tgz

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.log
.wrangler/
.DS_Store

# Build artifacts (static site output) — never commit; regenerate via scripts/build-distribution-site.sh
docs-site/site/

# Coverage reports — never commit
.coverage
**/.coverage

# Kilo agent working directory — not part of the repo
.agents/

# Dropped agent-hub project — not part of the release
apps/agent-hub.dropped/

# Frontend build output — regenerate, never commit
apps/sre-console/dist/
